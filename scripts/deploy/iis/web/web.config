<?xml version="1.0" encoding="utf-8"?>
<!--
  career-portal / web — TanStack Start (Nitro node-server) hosted by IIS through the
  ASP.NET Core Module V2 (out-of-process). IIS starts node.exe, assigns it a private
  port (ASPNETCORE_PORT) and reverse-proxies every request to it. No URL Rewrite/ARR needed.
  Works as is with IIS Manager "Add Website" (node.exe must be on the system PATH).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="node.exe"
                  arguments="--enable-source-maps .\iis-launch.mjs"
                  hostingModel="outofprocess"
                  startupTimeLimit="60"
                  shutdownTimeLimit="15"
                  requestTimeout="00:02:00"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\node">
        <environmentVariables>
          <environmentVariable name="NODE_ENV" value="production" />
          <!-- Optional: API_INTERNAL_URL forces the address SSR uses for /api calls.
               Default: the same site and binding the visitor used (see iis-launch.mjs). -->
        </environmentVariables>
      </aspNetCore>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
      <security>
        <requestFiltering removeServerHeader="true">
          <!-- 10 MB: CV uploads are capped at 5 MB by the API. -->
          <requestLimits maxAllowedContentLength="10485760" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
