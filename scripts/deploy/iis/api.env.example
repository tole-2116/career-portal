# Career Portal API settings. Copy this file to data\api.env (same folder) and edit it.
# The API reads it on start (api\iis-launch.cjs); recycle the IIS application pool after a change.

# REQUIRED. PostgreSQL connection. Special characters in the password must be URL-encoded:
#   @ -> %40   # -> %23   ! -> %21   : -> %3A   / -> %2F   % -> %25
DATABASE_URL="postgresql://hriscareer:YOUR_PASSWORD@localhost:5432/hriscareer?schema=public"

# First start only: creates this admin when the database has no admin yet.
# Remove the password line after the first successful login.
INITIAL_ADMIN_EMAIL="admin@careerportal.com"
INITIAL_ADMIN_PASSWORD=""

# Optional (defaults shown). JWT_SECRET is generated into data\jwt-secret.txt when not set.
# JWT_SECRET=""
# JWT_ACCESS_TTL="15m"
# JWT_REFRESH_TTL_DAYS="7"
# CLIENT_URL="https://career.example.com"   # only needed if another site calls this API (CORS)
