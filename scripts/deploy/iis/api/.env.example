# Production settings for career-portal API.
# setup-iis.ps1 copies this to <DataDir>\api.env on first run; edit that copy, not this file.
# Values already set in web.config (NODE_ENV, UPLOAD_DIR, PORT) take precedence.

DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<database>?schema=public"
CLIENT_URL="https://<your-domain>"
JWT_SECRET="<random string, at least 32 bytes>"
JWT_ISSUER="career-portal-api"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="7"
