<?xml version="1.0" encoding="utf-8"?>
<!--
  career-portal / api — Express API hosted as the IIS application "/api" through the
  ASP.NET Core Module V2 (out-of-process). The full request path (/api/...) is forwarded.
  Secrets live in the file named by DOTENV_CONFIG_PATH (outside the release folder).
  setup-iis.ps1 rewrites processPath and the environment values below on each deploy.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <remove name="aspNetCore" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="node.exe"
                  arguments="--enable-source-maps .\iis-launch.cjs"
                  hostingModel="outofprocess"
                  startupTimeLimit="60"
                  shutdownTimeLimit="15"
                  requestTimeout="00:02:00"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\node">
        <environmentVariables>
          <environmentVariable name="NODE_ENV" value="production" />
          <environmentVariable name="DOTENV_CONFIG_PATH" value=".\.env" />
          <environmentVariable name="UPLOAD_DIR" value=".\uploads" />
        </environmentVariables>
      </aspNetCore>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
      <security>
        <requestFiltering removeServerHeader="true">
          <requestLimits maxAllowedContentLength="10485760" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
