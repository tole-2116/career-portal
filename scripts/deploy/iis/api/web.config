<?xml version="1.0" encoding="utf-8"?>
<!--
  career-portal / api — Express API hosted as the IIS application "/api" through the
  ASP.NET Core Module V2 (out-of-process). The full request path (/api/...) is forwarded.
  Works as is with IIS Manager "Add Application" under any alias (node.exe on the system PATH).
  Settings (DATABASE_URL, ...) are read from ..\data\api.env by iis-launch.cjs.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- Servers with "WebDAV Publishing" installed answer PUT/DELETE with 405 before the request
           reaches Node (admin saves and deletes fail). Remove WebDAV for this application. -->
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <remove name="aspNetCore" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="node.exe"
                  arguments="--enable-source-maps .\iis-launch.cjs"
                  hostingModel="outofprocess"
                  startupTimeLimit="60"
                  shutdownTimeLimit="15"
                  requestTimeout="00:02:00"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\node">
        <environmentVariables>
          <environmentVariable name="NODE_ENV" value="production" />
          <!-- Optional: DOTENV_CONFIG_PATH (default ..\data\api.env), UPLOAD_DIR (default
               ..\data\uploads), AUTO_MIGRATE=false, API_PATH_ALIASES (see iis-launch.cjs). -->
        </environmentVariables>
      </aspNetCore>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
      <security>
        <requestFiltering removeServerHeader="true">
          <!-- 30 MB: site configuration saves embed images (API JSON limit 25 MB); CVs are capped at 5 MB. -->
          <requestLimits maxAllowedContentLength="31457280" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
