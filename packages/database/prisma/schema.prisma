generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String        @id @default(uuid())
  code           String?       @unique @db.VarChar(100)
  email          String        @unique
  passwordHash   String
  name           String
  role           Role          @default(CANDIDATE)
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  usercreate_at  String?       @db.VarChar(255)
  userupdated_at String?       @db.VarChar(255)
  isdelete       Boolean       @default(false)
  candidates     Candidate[]
  news           News[]
  refreshTokens  RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id            String    @id @default(uuid())
  tokenHash     String    @unique
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  revokedAt     DateTime?
  replacedById  String?
  replacedBy    RefreshToken?  @relation("TokenReplacement", fields: [replacedById], references: [id])
  replacedFrom  RefreshToken[] @relation("TokenReplacement")
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())
  userAgent     String?   @db.VarChar(500)
  ipAddress     String?   @db.VarChar(45)

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

model Taxonomy {
  id             String   @id @default(uuid())
  code           String   @unique @db.VarChar(100)
  type           String
  name           Json
  slug           String   @unique
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  usercreate_at  String?  @db.VarChar(255)
  userupdated_at String?  @db.VarChar(255)
  isdelete       Boolean  @default(false)
  jobs           Job[]  @relation("JobTaxonomy")
  departmentJobs Job[]  @relation("JobDepartment")
  workTypeJobs   Job[]  @relation("JobWorkType")
  salaryJobs     Job[]  @relation("JobSalary")
  experienceJobs Job[]  @relation("JobExperience")
  candidateExperiences Candidate[] @relation("CandidateExperience")

  @@index([type])
  @@map("taxonomies")
}

model Job {
  id             String        @id @default(uuid())
  code           String?       @unique @db.VarChar(100)
  title          Json
  summary        Json?
  slug           String        @unique
  description    Json?
  requirements   Json?
  benefits       Json?
  extraFields    Json          @default("[]")
  applicants     Int           @default(0)
  featured       Boolean       @default(false)
  posted         DateTime      @default(now())
  deadline       DateTime      @default(now())
  headcount      Int?
  experienceId   String?
  experience     Json?
  languages      Json?
  contactName    String?
  contactEmail   String?
  status         JobStatus     @default(OPEN)
  departmentId   String?       @db.VarChar(100)
  locationIds    String?       @db.VarChar(500)
  workTypeId     String?       @db.VarChar(100)
  salaryId       String?       @db.VarChar(100)
  level          Json?
  taxonomyId     String?       @db.VarChar(100)
  usercreate_at  String?       @db.VarChar(255)
  userupdated_at String?       @db.VarChar(255)
  isdelete       Boolean       @default(false)
  candidates     Candidate[]
  taxonomy          Taxonomy?  @relation("JobTaxonomy", fields: [taxonomyId], references: [id])
  departmentTaxonomy Taxonomy? @relation("JobDepartment", fields: [departmentId], references: [id])
  workTypeTaxonomy Taxonomy? @relation("JobWorkType", fields: [workTypeId], references: [id])
  salaryTaxonomy   Taxonomy? @relation("JobSalary", fields: [salaryId], references: [id])
  experienceTaxonomy Taxonomy? @relation("JobExperience", fields: [experienceId], references: [id])
  // locationIds giữ nhiều taxonomy id nối bằng dấu phẩy nên không khai báo relation.

  @@index([salaryId])
  @@index([experienceId])
  @@map("jobs")
}

model Candidate {
  id              String         @id @default(uuid())
  code            String         @unique @db.VarChar(100)
  jobId           String
  candidateUserId String?
  name            String         @db.VarChar(255)
  email           String         @db.VarChar(255)
  phone           String         @db.VarChar(50)
  address         String?        @db.VarChar(500)
  currentCompany  String?        @db.VarChar(255)
  experienceYears Int            @default(0)
  status          CandidateStatus @default(NEW)
  appliedAt       DateTime       @default(now())
  cvFile          String?        @db.Text
  experienceId     String?
  coverLetter     String?        @db.Text
  highlights      Json           @default("[]")
  notes           Json           @default("[]")
  rating          Int?           @default(0)
  formData        Json?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  usercreate_at   String?        @db.VarChar(255)
  userupdated_at  String?        @db.VarChar(255)
  isdelete        Boolean        @default(false)
  job             Job            @relation(fields: [jobId], references: [id])
  candidateUser   User?          @relation(fields: [candidateUserId], references: [id])
  experienceTaxonomy Taxonomy?   @relation("CandidateExperience", fields: [experienceId], references: [id])

  @@index([jobId])
  @@index([experienceId])
  @@index([email])
  @@index([status])
  @@map("candidates")
}

model News {
  id             String   @id @default(uuid())
  code           String?  @unique @db.VarChar(100)
  categoryId     String
  title          Json
  slug           String   @unique
  coverUrl       String?
  authorId       String
  date           DateTime @default(now())
  published      Boolean  @default(false)
  featured       Boolean  @default(false)
  excerpt        Json     @default("{}")
  body           Json     @default("{}")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  usercreate_at  String?  @db.VarChar(255)
  userupdated_at String?  @db.VarChar(255)
  isdelete       Boolean  @default(false)
  author         User     @relation(fields: [authorId], references: [id])

  @@map("news")
}

model form_configs {
  id             String   @id @default(uuid())
  code           String?  @unique @db.VarChar(100)
  name           String
  sections       Json
  submitLabel    Json
  successTitle   Json
  successBody    Json
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  usercreate_at  String?  @db.VarChar(255)
  userupdated_at String?  @db.VarChar(255)
  isdelete       Boolean  @default(false)

  @@map("form_configs")
}

model site_configs {
  id             String    @id @default(uuid())
  code           String?   @unique @db.VarChar(100)
  layout         String
  paletteId      String
  primary        String
  accent         String
  surfaceTone    String
  images         Json
  copy           Json
  sections       Json
  company        Json
  about          Json
  jobsPage       Json
  modules        Json
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  usercreate_at  String?   @db.VarChar(255)
  userupdated_at String?   @db.VarChar(255)
  isdelete       Boolean   @default(false)

  @@map("site_configs")
}

enum Role {
  ADMIN
  RECRUITER
  CANDIDATE
}

enum JobStatus {
  DRAFT
  OPEN
  PAUSED
  EXPIRED
  CLOSED
}

enum CandidateStatus {
  NEW
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}
