generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String        @id @default(uuid())
  code           String?       @unique @db.VarChar(100)
  email          String        @unique
  passwordHash   String
  name           String
  role           Role          @default(CANDIDATE)
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  usercreate_at  String?       @db.VarChar(255)
  userupdated_at String?       @db.VarChar(255)
  isdelete       Boolean       @default(false)
  candidates     Candidate[]
  news           News[]

  @@map("users")
}

model Taxonomy {
  id             String   @id @default(uuid())
  code           String   @unique @db.VarChar(100)
  type           String
  name           Json
  slug           String   @unique
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  usercreate_at  String?  @db.VarChar(255)
  userupdated_at String?  @db.VarChar(255)
  isdelete       Boolean  @default(false)
  jobs           Job[]

  @@map("taxonomies")
}

model Job {
  id             String        @id @default(uuid())
  code           String?       @unique @db.VarChar(100)
  title          Json
  slug           String        @unique
  description    Json
  requirements   Json
  benefits       Json          @default("[]")
  extraFields    Json          @default("[]")
  applicants     Int           @default(0)
  featured       Boolean       @default(false)
  posted         DateTime      @default(now())
  deadline       DateTime      @default(now())
  headcount      Int?
  experienceId   String?
  experience     Json?
  languages      Json?
  contactName    String?
  contactEmail   String?
  status         JobStatus     @default(PUBLISHED)
  department     String?
  location       String?
  type           String?
  taxonomyId     String?
  usercreate_at  String?       @db.VarChar(255)
  userupdated_at String?       @db.VarChar(255)
  isdelete       Boolean       @default(false)
  candidates     Candidate[]
  taxonomy       Taxonomy?     @relation(fields: [taxonomyId], references: [id])

  @@map("jobs")
}

model Candidate {
  id              String         @id @default(uuid())
  code            String         @unique @db.VarChar(100)
  jobId           String
  candidateUserId String?
  name            String         @db.VarChar(255)
  email           String         @db.VarChar(255)
  phone           String         @db.VarChar(50)
  currentCompany  String?        @db.VarChar(255)
  experienceYears Int            @default(0)
  status          CandidateStatus @default(NEW)
  appliedAt       DateTime       @default(now())
  resumeUrl       String         @db.Text
  coverLetter     String?        @db.Text
  notes           String?        @db.Text
  rating          Int?           @default(0)
  formData        Json?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  usercreate_at   String?        @db.VarChar(255)
  userupdated_at  String?        @db.VarChar(255)
  isdelete        Boolean        @default(false)
  job             Job            @relation(fields: [jobId], references: [id])
  candidateUser   User?          @relation(fields: [candidateUserId], references: [id])

  @@index([jobId])
  @@index([email])
  @@index([status])
  @@map("candidates")
}

model News {
  id             String   @id @default(uuid())
  code           String?  @unique @db.VarChar(100)
  categoryId     String
  title          Json
  slug           String   @unique
  coverUrl       String?
  authorId       String
  date           DateTime @default(now())
  published      Boolean  @default(false)
  featured       Boolean  @default(false)
  excerpt        Json     @default("{}")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  usercreate_at  String?  @db.VarChar(255)
  userupdated_at String?  @db.VarChar(255)
  isdelete       Boolean  @default(false)
  author         User     @relation(fields: [authorId], references: [id])

  @@map("news")
}

model form_configs {
  id           String @id
  name         String
  sections     Json
  submitLabel  Json
  successTitle Json
  successBody  Json
}

model site_configs {
  id          String @id
  layout      String
  paletteId   String
  primary     String
  accent      String
  surfaceTone String
  images      Json
  copy        Json
  sections    Json
  company     Json
  about       Json
  jobsPage    Json
  modules     Json
}

enum Role {
  ADMIN
  RECRUITER
  CANDIDATE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum CandidateStatus {
  NEW
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}
