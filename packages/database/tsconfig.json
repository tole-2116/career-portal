{
  "extends": "@career-portal/typescript-config/base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@/*": ["../apps/web/src/*"]
    }
  },
  "include": ["src/**/*", "prisma/**/*"],
  "exclude": ["prisma/migrations"]
}
